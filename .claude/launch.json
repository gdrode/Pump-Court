{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pumpcourt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "pumpCourt",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "pumpcourt-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "pumpCourt",
        "run",
        "dev:local",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}